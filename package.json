{
  "name": "movieseatfinder",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/scripts/app.js src/scripts/dither.js src/styles/styles.css src/styles/mcp.css --bundle --format=esm --minify --legal-comments=none --external:/*.woff2 --outdir=src/dist --entry-names=[name].bundle && node -e \"require('node:fs').cpSync('src/assets', 'src/dist', { recursive: true })\"",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --config config/prettier.json --ignore-path .gitignore --ignore-path config/prettierignore --write .",
    "format:check": "prettier --config config/prettier.json --ignore-path .gitignore --ignore-path config/prettierignore --check .",
    "lint": "oxlint --config config/oxlint.json --deny-warnings src/scripts tests",
    "lint:fix": "oxlint --config config/oxlint.json --fix src/scripts tests",
    "knip": "knip --config config/knip.json --no-config-hints"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "knip": "6.31.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
